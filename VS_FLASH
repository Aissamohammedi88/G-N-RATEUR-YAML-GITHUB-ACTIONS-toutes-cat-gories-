class ReasoningEngine:
def __init__(self): self.steps = []
def analyze(self, prompt, langage):
t0 = time.time()
prompt_lower = prompt.lower()
analysis = {
"prompt": prompt, "langage": langage,
"niches": detecter_niche(langage) if langage in LANGAGES_SUPPORTES else [],
"mots_cles": [kw for kw in ["api","rest","http","server","db","auth","cache","cli","web","game","ml"] if kw in prompt_lower],
}
self.steps.append({"phase": "analyze", "duration_ms": round((time.time()-t0)*1000, 2), "result": analysis})
return analysis
def plan(self, analysis, cible):
t0 = time.time()
plan = {"modules": cible // 8, "types": ["Handler","Service","Model","Validator","Repo","Logger","Cache","Processor"], "cible": cible}
self.steps.append({"phase": "plan", "duration_ms": round((time.time()-t0)*1000, 2), "result": plan})
return plan
def critique(self, code, langage):
t0 = time.time()
a = analyser_code(code, langage)
result = {"score": max(0, 100 - len(a["problemes"]) * 3), "total": len(a["problemes"]), "metriques": a["metriques"]}
self.steps.append({"phase": "critique", "duration_ms": round((time.time()-t0)*1000, 2), "result": result})
return result
def verify(self, code, langage):
t0 = time.time()
r = verify_full(code, langage)
self.steps.append({"phase": "verify", "duration_ms": round((time.time()-t0)*1000, 2), "result": r})
return r
def full(self, prompt, langage, cible):
t0 = time.time(); self.steps = []
a = self.analyze(prompt, langage)
p = self.plan(a, cible)
gt0 = time.time(); code = generer_massif(prompt, langage, 3001, cible)
self.steps.append({"phase": "generate", "duration_ms": round((time.time()-gt0)*1000, 2), "result": {"lignes": code.count("\n")+1, "octets": len(code.encode())}})
c = self.critique(code, langage)
v = self.verify(code, langage)
return {"ok": True, "code": code, "lignes": code.count("\n")+1, "cible": cible,
"octets": len(code.encode()), "analysis": a, "plan": p, "critique": c,
"verification": v, "steps": self.steps,
"duration_ms": round((time.time()-t0)*1000, 2)}

