HTTP_CACHE = {}
HTTP_LOCK = threading.Lock()

def http_get(url, headers=None, timeout=10, use_cache=True):
if use_cache:
with HTTP_LOCK:
e = HTTP_CACHE.get(url)
if e and time.time() - e["ts"] < 300: return e["data"]
h = {"User-Agent": f"NexusGen/{VERSION}", "Accept": "*/*"}
if headers: h.update(headers)
try:
req = urllib.request.Request(url, headers=h)
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
data = r.read().decode("utf-8", "ignore")
if use_cache:
with HTTP_LOCK: HTTP_CACHE[url] = {"data": data, "ts": time.time()}
return data
except Exception as e:
return f'{{"error":"{str(e)[:100]}"}}'

def http_post_json(url, payload, headers=None, timeout=10):
h = {"Content-Type": "application/json", "User-Agent": f"NexusGen/{VERSION}"}
if headers: h.update(headers)
try:
body = json.dumps(payload).encode()
req = urllib.request.Request(url, data=body, headers=h, method="POST")
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
return json.loads(r.read().decode("utf-8", "ignore"))
except Exception as e:
return {"error": str(e)[:200]}

def http_get_json(url, headers=None, timeout=10, use_cache=True):
raw = http_get(url, headers, timeout, use_cache)
try: return json.loads(raw)
except: return {"error": "invalid_json"}

