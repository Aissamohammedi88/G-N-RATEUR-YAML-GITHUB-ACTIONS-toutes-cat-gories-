def _yaml_header(prompt, cible):
return f'''# NEXUS YAML — GitHub Actions
# Prompt: {prompt[:60]}
# Cible : {cible} lignes

name: "{prompt[:50]}"

on:
push:
branches: [ main, master ]
pull_request:
workflow_dispatch:

permissions:
contents: read
pull-requests: write

concurrency:
group: ${{{{ github.workflow }}}}-${{{{ github.ref }}}}
cancel-in-progress: true

env:
NODE_VERSION: '20'
PYTHON_VERSION: '3.11'

jobs:
'''

def _yaml_job(mid):
cats = list(GITHUB_CATEGORIES.keys())
cat = cats[mid % len(cats)]
variants = GITHUB_CATEGORIES[cat]
variant = variants[mid % len(variants)]
job_name = f"{cat}-{variant}-{mid:04d}"
return f'''
# ─────────────────────────────────────────
# JOB {mid:04d} — {cat.upper()} / {variant}
# ─────────────────────────────────────────
{job_name}:
name: "{cat} {variant} #{mid}"
runs-on: ubuntu-latest
timeout-minutes: 30
steps:
- uses: actions/checkout@v4
- uses: actions/setup-node@v4
with:
node-version: ${{{{ env.NODE_VERSION }}}}
cache: 'npm'
- name: Lint
run: echo "Lint job {mid:04d}"
- name: Test
run: echo "Test job {mid:04d}"
- name: Build
run: echo "Build job {mid:04d}"
'''

def generer_yaml_github(prompt, cible=1000):
header = _yaml_header(prompt, cible)
jobs = []
lignes = header.count("\n")
mid = 1
while lignes < cible and mid <= 500:
job = _yaml_job(mid)
jobs.append(job); lignes += job.count("\n"); mid += 1
return header + "\n".join(jobs) + f"\n# FIN — {mid-1} jobs, {lignes} lignes\n"

def validate_yaml_github(yaml_content):
result = {"ok": True, "errors": [], "warnings": [], "info": [], "score": 100, "yaml_valid": False}
if not yaml_content.strip():
result["ok"] = False
result["errors"].append({"code": "EMPTY", "msg": "YAML vide"})
return result
try:
import yaml
data = yaml.safe_load(yaml_content)
result["yaml_valid"] = True
result["info"].append({"code": "YAML_OK", "msg": "Syntaxe YAML valide"})
except ImportError:
result["warnings"].append({"code": "NO_PYYAML", "msg": "PyYAML non installé"})
data = None
except Exception as e:
result["ok"] = False
result["errors"].append({"code": "YAML_SYNTAX", "msg": str(e)[:200]})
return result
if isinstance(data, dict):
for field in ["on", "jobs"]:
if field not in data:
result["ok"] = False
result["errors"].append({"code": f"MISSING_{field.upper()}", "msg": f"Champ '{field}' manquant"})
if "jobs" in data and isinstance(data["jobs"], dict):
for jn, job in data["jobs"].items():
if isinstance(job, dict):
if "runs-on" not in job and "uses" not in job:
result["errors"].append({"code": "MISSING_RUNS_ON", "msg": f"Job '{jn}': runs-on manquant"})
for step in job.get("steps", []):
if isinstance(step, dict) and "uses" in step:
action = step["uses"]
if "@" not in action:
result["errors"].append({"code": "NO_VERSION", "msg": f"Action '{action}' sans version"})
if "permissions" not in data:
result["warnings"].append({"code": "NO_PERMISSIONS", "msg": "Pas de permissions"})
# Dangers
for pattern, msg, sev in [
(r"pull_request_target", "pull_request_target dangereux", "CRITICAL"),
(r"\$\{\{\s*github\.event\.(pull_request|issue)\.(title|body)\s*\}\}", "Injection possible", "CRITICAL"),
(r"curl\s+[^|]*\|\s*(?:ba)?sh", "curl|bash", "CRITICAL"),
(r"echo\s+.*secrets\.", "Secret exposé", "HIGH"),
]:
for m in re.finditer(pattern, yaml_content, re.IGNORECASE):
line_num = yaml_content[:m.start()].count("\n") + 1
sev_key = "errors" if sev in ("CRITICAL", "HIGH") else "warnings"
result[sev_key].append({"code": f"DANGER_{sev}", "msg": f"{msg} (ligne {line_num})"})
result["score"] = max(0, 100 - len(result["errors"]) * 10 - len(result["warnings"]) * 3)
result["ok"] = len(result["errors"]) == 0
result["verdict"] = "✅ VALIDE" if result["ok"] and not result["warnings"] else ("⚠️ AVERTISSEMENTS" if result["ok"] else "❌ INVALIDE")
return result

def optimize_yaml_github(yaml_content):
result = {"ok": True, "optimizations": [], "score_before": 0, "score_after": 0}
validation = validate_yaml_github(yaml_content)
result["score_before"] = validation["score"]
if not yaml_content.strip(): return result
# Caches
if "actions/setup-node" in yaml_content and "cache:" not in yaml_content:
result["optimizations"].append({"type": "cache", "priority": "HIGH", "msg": "Cache npm manquant", "gain": "~40% de temps", "fix": "Ajouter 'cache: npm' à setup-node"})
if "actions/setup-python" in yaml_content and "cache:" not in yaml_content:
result["optimizations"].append({"type": "cache", "priority": "HIGH", "msg": "Cache pip manquant", "gain": "~60% de temps", "fix": "Ajouter 'cache: pip' à setup-python"})
if "concurrency:" not in yaml_content:
result["optimizations"].append({"type": "concurrency", "priority": "HIGH", "msg": "Pas de concurrency", "gain": "Annule runs obsolètes", "fix": "Ajouter 'concurrency: {group:..., cancel-in-progress: true}'"})
if "permissions:" not in yaml_content:
result["optimizations"].append({"type": "security", "priority": "HIGH", "msg": "Pas de permissions", "gain": "Sécurité", "fix": "Ajouter 'permissions: {contents: read}'"})
# Actions obsolètes
obs = {"actions/checkout@v1":"v4","actions/checkout@v2":"v4","actions/checkout@v3":"v4",
"actions/setup-node@v1":"v4","actions/setup-node@v2":"v4","actions/setup-node@v3":"v4",
"actions/upload-artifact@v1":"v4","actions/upload-artifact@v2":"v4","actions/upload-artifact@v3":"v4"}
for old, new in obs.items():
if old in yaml_content:
result["optimizations"].append({"type": "obsolete", "priority": "HIGH", "msg": f"Action obsolète: {old}", "gain": "Sécurité", "fix": f"Remplacer par ...@{new}"})
bonus = sum(5 if o["priority"]=="CRITICAL" else 3 if o["priority"]=="HIGH" else 1 for o in result["optimizations"])
result["score_after"] = min(100, validation["score"] + bonus)
return result

