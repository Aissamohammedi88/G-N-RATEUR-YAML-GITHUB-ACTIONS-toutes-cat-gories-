def _tool_available(cmd):
try:
subprocess.run([cmd, "--version"], capture_output=True, timeout=3)
return True
except (FileNotFoundError, subprocess.TimeoutExpired):
return False

def check_compiler(code, langage):
if langage not in COMPILERS:
return {"ok": False, "error": f"Langage non supporté: {langage}"}
tool = COMPILERS[langage]["syntax"][0]
if not _tool_available(tool):
return {"ok": False, "error": f"Outil {tool} non installé"}
ext = COMPILERS[langage]["ext"]
with tempfile.NamedTemporaryFile(mode="w", suffix=ext, delete=False) as f:
f.write(code); tmp = f.name
try:
r = subprocess.run(COMPILERS[langage]["syntax"] + [tmp], capture_output=True, text=True, timeout=30)
return {"ok": r.returncode == 0, "stdout": r.stdout[:1000], "stderr": r.stderr[:1000]}
except subprocess.TimeoutExpired:
return {"ok": False, "error": "Timeout 30s"}
finally:
try: os.unlink(tmp)
except: pass

def check_python_ast(code):
try:
import ast
tree = ast.parse(code)
funcs = len([n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)])
classes = len([n for n in ast.walk(tree) if isinstance(n, ast.ClassDef)])
return {"ok": True, "functions": funcs, "classes": classes}
except SyntaxError as e:
return {"ok": False, "error": f"SyntaxError ligne {e.lineno}: {e.msg}"}
except Exception as e:
return {"ok": False, "error": str(e)[:200]}

def check_obsolete(code, langage):
if langage not in COMPILERS or not COMPILERS[langage]["obsolete"]:
return {"ok": True, "note": "Pas de vérificateur d'obsolescence", "issues": []}
tool = COMPILERS[langage]["obsolete"][0]
if not _tool_available(tool):
return {"ok": True, "note": f"{tool} non installé", "issues": []}
ext = COMPILERS[langage]["ext"]
with tempfile.NamedTemporaryFile(mode="w", suffix=ext, delete=False) as f:
f.write(code); tmp = f.name
try:
r = subprocess.run(COMPILERS[langage]["obsolete"] + [tmp], capture_output=True, text=True, timeout=30)
issues = [l.strip()[:200] for l in (r.stdout + r.stderr).split("\n")
if any(k in l.lower() for k in ["deprecated", "obsolete", "outdated"])]
return {"ok": len(issues) == 0, "issues": issues[:20], "count": len(issues)}
except subprocess.TimeoutExpired:
return {"ok": True, "note": "Timeout"}
finally:
try: os.unlink(tmp)
except: pass

