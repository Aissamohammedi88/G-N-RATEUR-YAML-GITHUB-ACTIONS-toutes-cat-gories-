def analyser_code(code, langage):
if not code: return {"problemes": [], "metriques": {}}
lignes = code.split("\n")
problemes = []
for pattern, nom, sev in PATTERNS_SECRETS:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
if any(x in ligne.lower() for x in ["example","placeholder","xxx"]): continue
problemes.append({"type": nom, "severite": sev, "ligne": i, "extrait": ligne.strip()[:120]})
for pattern, nom, sev in PATTERNS_TODO:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
problemes.append({"type": nom, "severite": sev, "ligne": i, "extrait": ligne.strip()[:120]})
if langage.lower() in PATTERNS_DANGER:
for pattern, nom, sev in PATTERNS_DANGER[langage.lower()]:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
stripped = ligne.strip()
if stripped.startswith(("#","//","/*","*","--")): continue
problemes.append({"type": nom, "severite": sev, "ligne": i, "extrait": stripped[:120]})
lignes_vides = sum(1 for l in lignes if not l.strip())
return {"problemes": problemes, "metriques": {
"lignes_total": len(lignes), "lignes_vides": lignes_vides,
"lignes_code": len(lignes) - lignes_vides,
"octets": len(code.encode("utf-8", "ignore")),
}}

